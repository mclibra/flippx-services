option_settings:
  # Force environment to use load balancer (required for WebSockets)
  aws:elasticbeanstalk:environment:
    EnvironmentType: LoadBalanced
  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: nginx
  # Configure Application Load Balancer for WebSocket support
  aws:elbv2:loadbalancer:
    IdleTimeout: 300
    Scheme: internet-facing
    Type: application
  aws:elbv2:listener:80:
    Protocol: HTTP
    DefaultProcess: default
  aws:elbv2:listenerrule:default:
    PathPatterns: '/*'
    Priority: 1
    Process: default
  aws:elbv2:targetgroup:default:
    HealthCheckPath: /api/health
    HealthCheckInterval: 30
    HealthCheckTimeout: 5
    HealthyThresholdCount: 2
    UnhealthyThresholdCount: 5
    # Enable sticky sessions for WebSocket persistence
    StickinessEnabled: true
    StickinessLBCookieDuration: 86400
    TargetType: instance
    Protocol: HTTP
    Port: 80
  # Configure auto scaling for load balanced environment
  aws:autoscaling:asg:
    MinSize: 1
    MaxSize: 3
    AvailabilityZones: Any 3
  aws:autoscaling:launchconfiguration:
    InstanceType: t2.medium
    SecurityGroups: default
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    PORT: 8080
    IP: 0.0.0.0
